inherit cabal

DESCRIPTION="The official Haskell language server (LSP) implementation"
HOMEPAGE="https://haskell-language-server.readthedocs.io/en/latest/"
SRC_URI="
	https://github.com/haskell/haskell-language-server/releases/download/${PV}/${P}-src.tar.gz
	${CABAL_PACKAGES_SRC_URIS}
"

LICENSE="Apache-2.0"
SLOT="0/${PV}"
KEYWORDS="~amd64"
RESTRICT="mirror test"

RDEPEND="
	dev-libs/gmp:=
	dev-libs/libffi:=
	virtual/zlib:=
"
DEPEND="${RDEPEND}"
BDEPEND="
	dev-lang/ghc
	dev-haskell/cabal-install
"

src_unpack() {
	unpack "${P}-src.tar.gz"
	cabal_src_unpack
}

src_prepare() {
	cp "${FILESDIR}/${PF}.freeze" cabal.project.freeze || die

	default
}

src_configure() {
	cabal_src_configure --flags "-dynamic"
}

src_install() {
	dobin "$(cabal list-bin exe:haskell-language-server)"
}
